# The vLLM pin: the release every row's image is tagged with, and each host class's image
# repository. Sourced by lib/row.sh and scripts/currency.sh. See context/engines.md.
# Adapted from spike-model-engines (6ce3210): host/vllm.env, its flavors' repositories named by host
# class, without the rows, the default rows, tracing, or native vLLM's Python.
VLLM_RELEASE=v0.34.0
VLLM_REPOSITORY_GB10=vllm/vllm-openai
VLLM_REPOSITORY_STRIX_HALO=vllm/vllm-openai-rocm
